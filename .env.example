# Environment variables for EarlyTrendBD

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True

# Database
DATABASE_URL=sqlite:///./earlytrend.db

# Model Paths
MODEL_PATH=models/trained_models
DATA_PATH=data/processed
LOG_PATH=logs

# Training Settings
NUM_PRODUCTS=150
DAYS_HISTORY=30
TRAIN_EPOCHS=50
BATCH_SIZE=32

# Model Architecture
LSTM_SEQUENCE_LENGTH=7
XGBOOST_MAX_DEPTH=7
XGBOOST_N_ESTIMATORS=100

# Ensemble Weights
LSTM_WEIGHT=0.4
XGBOOST_WEIGHT=0.6

# Logging
LOG_LEVEL=INFO
